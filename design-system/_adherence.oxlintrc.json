{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/controls/**",
              "components/monitor/**",
              "components/status/**",
              "components/timeline/**",
              "components/vitals/**",
              "ui_kits/aar/**",
              "ui_kits/instructor/**",
              "ui_kits/trainee/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans Hebrew|IBM Plex Sans Condensed|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans Hebrew, IBM Plex Sans Condensed, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntsRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|value|anchors|evidenceCount|onChange|onJumpToEvidence|lang|key|ref|className|style|children)$/]",
        "message": "<AntsRating> doesn't accept that prop. Declared props: category, value, anchors, evidenceCount, onChange, onJumpToEvidence, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntsRating'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:he|en)$/]",
        "message": "<AntsRating> lang must be one of 'he' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|iconStart|iconEnd|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, iconStart, iconEnd, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|lang|key|ref|className|style|children)$/]",
        "message": "<ConnectionPill> doesn't accept that prop. Declared props: state, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionPill'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:he|en)$/]",
        "message": "<ConnectionPill> lang must be one of 'he' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|variant|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, icon, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<IconButton> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InjectionTrigger'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|kind|icon|fired|firedAt|onFire|key|ref|className|style|children)$/]",
        "message": "<InjectionTrigger> doesn't accept that prop. Declared props: title, description, kind, icon, fired, firedAt, onFire."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonitorPatient'] > JSXAttribute > JSXIdentifier[name!=/^(?:species|breed|weightKg|weightRange|name|key|ref|className|style|children)$/]",
        "message": "<MonitorPatient> doesn't accept that prop. Declared props: species, breed, weightKg, weightRange, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonitorPatient'] > JSXAttribute[name.name='species'] > Literal[value!=/^(?:dog|cat)$/]",
        "message": "<MonitorPatient> species must be one of 'dog' | 'cat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionState'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|variant|elapsed|lang|key|ref|className|style|children)$/]",
        "message": "<SessionState> doesn't accept that prop. Declared props: state, variant, elapsed, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionState'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:badge|stepper)$/]",
        "message": "<SessionState> variant must be one of 'badge' | 'stepper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionState'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:he|en)$/]",
        "message": "<SessionState> lang must be one of 'he' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|appearance|size|lang|showLabel|value|key|ref|className|style|children)$/]",
        "message": "<SeverityChip> doesn't accept that prop. Declared props: level, appearance, size, lang, showLabel, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityChip'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:solid|outline|bare)$/]",
        "message": "<SeverityChip> appearance must be one of 'solid' | 'outline' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<SeverityChip> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityChip'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:he|en)$/]",
        "message": "<SeverityChip> lang must be one of 'he' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityGlyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|size|title|key|ref|className|style|children)$/]",
        "message": "<SeverityGlyph> doesn't accept that prop. Declared props: level, size, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityGlyph'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:normal|watch|elevated|critical)$/]",
        "message": "<SeverityGlyph> level must be one of 'normal' | 'watch' | 'elevated' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskWindow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|remaining|closing|key|ref|className|style|children)$/]",
        "message": "<TaskWindow> doesn't accept that prop. Declared props: label, remaining, closing."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:t|type|role|label|severity|key|ref|className|style|children)$/]",
        "message": "<TimelineMarker> doesn't accept that prop. Declared props: t, type, role, label, severity."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineMarker'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:action|injection|vitals|callout|phase)$/]",
        "message": "<TimelineMarker> type must be one of 'action' | 'injection' | 'vitals' | 'callout' | 'phase'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VitalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|abbr|value|unit|level|trend|stale|lastSeen|size|lang|key|ref|className|style|children)$/]",
        "message": "<VitalCard> doesn't accept that prop. Declared props: name, abbr, value, unit, level, trend, stale, lastSeen, size, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='VitalCard'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:up|down|flat)$/]",
        "message": "<VitalCard> trend must be one of 'up' | 'down' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VitalCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:station|compact)$/]",
        "message": "<VitalCard> size must be one of 'station' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VitalCard'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:he|en)$/]",
        "message": "<VitalCard> lang must be one of 'he' | 'en'."
      }
    ]
  },
