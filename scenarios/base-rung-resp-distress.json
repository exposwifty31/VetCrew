        "effects": [
          { "vital": "spo2", "ratePerSec": 0.5 },
          { "vital": "hr", "target": 190 }
        ]
      },
      {
        "id": "monitor-artifact",
        "on": { "kind": "injection", "injection": "monitor_artifact" },
        "effects": [{ "vital": "hr", "jitter": 6 }]
      }
    ]
  },
  "actions": [
