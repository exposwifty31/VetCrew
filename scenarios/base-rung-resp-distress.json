    { "id": "give_drug_iv_wrong_route", "label": "Give SC-only medication — IV route (route error)", "labelHe": "מתן תרופה תת-עורית — בדרך ורידית (שגיאת דרך מתן)" },
    { "id": "vitals_callout", "label": "Call out vitals change", "labelHe": "הכרזת שינוי במדדים" },
