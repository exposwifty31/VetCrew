# Server
PORT=3001
# Vite dev-server port. Parallel worktrees offset both ports by their slot so two
# checkouts never share a server or a database — see docs/worktrees.md.
# Deliberately NOT VITE_-prefixed: it must not reach the client bundle.
VETCREW_WEB_PORT=5173
# Postgres (Railway plugin injects this in production)
DATABASE_URL=postgres://user:pass@localhost:5432/vetcrew
# Integration test database (pnpm test:integration) — schema is DROPPED per run
TEST_DATABASE_URL=postgres://user:pass@localhost:5432/vetcrew_test
# Clerk — pull with `clerk env pull --file .env` after `clerk auth login`
# Omit all three in development for server/socket dev-bypass (not for pitch).
# VITE_ key is required at *build* time for the SPA bundle.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production Socket.IO CORS (optional; defaults to https://$RAILWAY_PUBLIC_DOMAIN)
# CORS_ORIGIN=https://web-production-xxxxx.up.railway.app
# CI/E2E only — set to 1 to enable Authorization: Bearer test:<userId>:manager|instructor|trainee
# Never set in production Railway
VETCREW_TEST_AUTH=
# CI/local pitch only — set to 1 to allow ratings on clinically_reviewed:false scenarios
# Unset in production Railway (server returns 403 scenario_not_clinically_reviewed)
VETCREW_ALLOW_UNREVIEWED_SCORES=
