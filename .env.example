# Server
PORT=3001
# Postgres (Railway plugin injects this in production)
DATABASE_URL=postgres://user:pass@localhost:5432/vetcrew
# Integration test database (pnpm test:integration) — schema is DROPPED per run
TEST_DATABASE_URL=postgres://user:pass@localhost:5432/vetcrew_test
# Clerk — pull with `clerk env pull --file .env` after `clerk auth login`
# Omit all three in development for server/socket dev-bypass (not for pitch).
# VITE_ key is required at *build* time for the SPA bundle.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production Socket.IO CORS (optional; defaults to https://$RAILWAY_PUBLIC_DOMAIN)
# CORS_ORIGIN=https://web-production-xxxxx.up.railway.app
