{
  "name": "vetcrew",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite",
    "dev:server": "NODE_OPTIONS='--conditions=development' tsx watch --env-file-if-exists=.env server/index.ts",
    "seed:demo": "NODE_OPTIONS='--conditions=development' tsx --env-file-if-exists=.env server/scripts/seed-demo.ts",

    "build:server": "tsc -b server/tsconfig.build.json --force && node scripts/copy-server-assets.mjs",
    "build": "pnpm build:server && vite build",
    "start": "node dist-server/index.js",

    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "i18n:check": "tsx scripts/check-i18n-parity.ts",
    "guard:deps": "tsx scripts/check-boundaries.ts",
    "guard:dead": "knip",
    "worktree": "tsx scripts/worktree.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.0",
    "@clerk/express": "^2.1.45",
    "@clerk/react": "^6.12.7",
    "@vetcrew/engine": "workspace:*",
    "@vetcrew/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "knip": "^6.29.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
